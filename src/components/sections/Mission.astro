---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Reveal from '../animations/Reveal';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const leftImg = 'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=600&q=80';
const rightImg = 'https://images.unsplash.com/photo-1519741497674-611481863552?w=600&q=80';
---

<section class="mission" id="mission">
  <div class="mission-side mission-left">
    <img src={leftImg} alt="Mission left" loading="lazy" />
  </div>

  <div class="mission-center">
    <Reveal client:visible>
      <h2 class="mission-title">{t('mission.title')}</h2>
    </Reveal>

    <div class="mission-divider"></div>

    <div class="mission-text">
      <Reveal client:visible delay={0.2}>
        <p>{t('mission.p1')}</p>
      </Reveal>
      <Reveal client:visible delay={0.35}>
        <p>{t('mission.p2')}</p>
      </Reveal>
    </div>
  </div>

  <div class="mission-side mission-right">
    <img src={rightImg} alt="Mission right" loading="lazy" />
  </div>
</section>

<style>
    .mission {
        display: grid;
        grid-template-columns: 1fr 1.6fr 1fr;
        min-height: 90vh;
    }

    .mission-side {
        overflow: hidden;
    }

    .mission-side img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mission-center {
        background: var(--color-terracotta);
        padding: clamp(60px, 10vw, 120px) clamp(40px, 6vw, 80px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: #fff;
        text-align: center;
    }

    .mission-title {
        font-family: var(--font-script);
        font-size: clamp(3rem, 6vw, 4.5rem);
        line-height: 1;
        color: #fff;
        font-weight: 400;
        margin: 0 0 32px;
    }

    .mission-divider {
        width: 100%;
        max-width: 400px;
        height: 1px;
        background: rgba(255, 255, 255, 0.4);
        margin: 0 auto 48px;
    }

    .mission-text {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 500px;
        margin: 0 auto;
    }

    .mission-text p {
        font-family: var(--font-serif);
        font-size: clamp(0.95rem, 1.4vw, 1.1rem);
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.95);
        margin: 0;
    }

    @media (max-width: 900px) {
        .mission {
            grid-template-columns: 1fr;
            grid-template-rows: 240px 1fr 240px;
        }
  }
</style>