---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Reveal from '../animations/Reveal';
import Button from '../ui/Button.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);


// TODO: reemplazar por datos reales
const CONTACT = {
  email: 'hola@parasiempre.mx',
  whatsapp: '521XXXXXXXXXX',
  instagram: 'https://www.instagram.com/parasiempremx/',
};
---

<section class="contact">
    <div class="contact-inner">
        <Reveal client:visible>
            <p class="eyebrow">— {t('contact.eyebrow')}</p>
        </Reveal>

        <Reveal client:visible delay={0.15}>
            <h2 class="contact-title">{t('contact.title')}</h2>
        </Reveal>

        <Reveal client:visible delay={0.3}>
            <p class="contact-subtitle">{t('contact.subtitle')}</p>
        </Reveal>

        <Reveal client:visible delay={0.45}>
            <div class="contact-buttons">
                <Button href={`mailto:${CONTACT.email}`} variant="primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                    {t('contact.email')}
                </Button>

                <Button href={`https://wa.me/${CONTACT.whatsapp}`} variant="secondary" external>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                    {t('contact.whatsapp')}
                </Button>

                <Button href={CONTACT.instagram} variant="outline" external>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                    </svg>
                    {t('contact.instagram')}
                </Button>
            </div>
        </Reveal>
    </div>
</section>

<style>
    .contact {
        padding: var(--spacing-section) var(--spacing-section-x);
        background: linear-gradient(160deg, var(--bg-alt), var(--bg));
        text-align: center;
    }

    .contact-inner {
        max-width: 900px;
        margin: 0 auto;
    }

    .eyebrow {
        font-family: var(--font-sans);
        font-size: 0.7rem;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--fg-soft);
        margin-bottom: 32px;
    }

    .contact-title {
        font-family: var(--font-script);
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 1;
        color: var(--color-terracotta);
        font-weight: 400;
        margin: 0 0 24px;
    }

    :root[data-theme='dark'] .contact-title {
        color: var(--color-terracotta-light);
    }

    .contact-subtitle {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        color: var(--fg-soft);
        margin: 0 0 60px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .contact-buttons {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }
</style>